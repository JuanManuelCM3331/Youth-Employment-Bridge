# ==========================================
# Entorno y Secretos
# ==========================================
.env
.env.*
.env.local
!.env.example
!.env.testing.example

# ==========================================
# Almacenamiento de Archivos y Subidas (Storage)
# ==========================================
/storage/cvs/*
!/storage/cvs/.gitkeep

/storage/avatars/*
!/storage/avatars/.gitkeep

/storage/company-avatars/*
!/storage/company-avatars/.gitkeep

# Reverso del documento de identidad (verificación por lectura de cédula o TI)
/storage/id-scans/*
!/storage/id-scans/.gitkeep
!/storage/id-scans/.htaccess

/public/uploads/*
!/public/uploads/.gitkeep

/public/storage/
/public/build/

# ==========================================
# Logs y Archivos de Ejecución
# ==========================================
*.log
/storage/logs/*
!/storage/logs/.gitkeep
/storage/cache/*
!/storage/cache/.gitkeep
/storage/framework/
/error_log
/php_errorlog

# ==========================================
# Dependencias y Paquetes
# ==========================================
/vendor/
/node_modules/
package-lock.json
composer.lock

# ==========================================
# Bases de Datos, Backups y Dumps Locales
# ==========================================
*.sql.gz
*.sql.bak
*.dump
*.sqlite
*.db

# ==========================================
# Pruebas y Caché de Herramientas
# ==========================================
.phpunit.result.cache
.phpunit.cache/

# ==========================================
# IDEs y Editores de Código
# ==========================================
.idea/
.vscode/
*.code-workspace
*.suo
*.user
*.userosv
*.sln.docstates

# ==========================================
# Sistema Operativo y Temporales
# ==========================================
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.bak
*~

# ==========================================
# Sistema Operativo y Temporales
# ==========================================
/tests

# ==========================================
# Docker � entorno local
# ==========================================
.env.docker
# No ignorar: Dockerfile, docker-compose.yml, docker/

