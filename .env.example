# Copy this file to .env and replace values locally. Never commit .env.
YEB_DB_HOST=127.0.0.1
YEB_DB_PORT=3306
YEB_DB_DATABASE=yeb_portal
YEB_DB_USERNAME=root
YEB_DB_PASSWORD=

# --- Validación de cédula (registro de candidatos y empresas) ---
# sandbox = simulador local, sin costo y sin credenciales (por defecto).
# http    = consulta real a una API externa de validación de cédulas.
YEB_CEDULA_PROVIDER=sandbox

# URL de la API. Admite el marcador {cedula}; si se omite, el número se envía como query string.
# Ejemplo: https://api.ejemplo.com/cedula/{cedula}
YEB_CEDULA_API_URL=

# Método HTTP de la consulta: GET | POST
YEB_CEDULA_API_METHOD=GET

# Credencial de la API (los planes gratuitos de los proveedores incluyen cuota mensual).
YEB_CEDULA_API_KEY=

# Header donde se envía la credencial (x-api-key, apikey, Authorization...).
YEB_CEDULA_API_KEY_HEADER=x-api-key

# Host adicional para proveedores tipo RapidAPI (header X-RapidAPI-Host).
YEB_CEDULA_API_HOST=

# Tiempo máximo de espera de la consulta en segundos.
YEB_CEDULA_API_TIMEOUT=8

# Tipo de documento consultado en la API (CC, CE, TI...).
YEB_CEDULA_DOCUMENT_TYPE=CC

# Edad máxima para crear una cuenta de candidato (0 = sin límite).
YEB_CEDULA_MAX_AGE=24

# Edad máxima para crear una cuenta de empresa (0 = sin límite).
YEB_CEDULA_MAX_AGE_COMPANY=0

# Verificar que el nombre capturado coincida con el registrado en la cédula (1 = sí, 0 = no).
YEB_CEDULA_NAME_MATCH=1

# Umbral de coincidencia de nombres (0 - 1).
YEB_CEDULA_NAME_THRESHOLD=0.8

# Si la API falla, permitir el registro (1) o bloquearlo (0).
YEB_CEDULA_FAIL_OPEN=0
